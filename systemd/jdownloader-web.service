[Unit]
Description=JDownloader Custom WebUI API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=jdweb
Group=jdownloader
WorkingDirectory=/opt/jdownloader-web/backend
EnvironmentFile=/etc/jdownloader-web/config.env
ExecStart=/opt/jdownloader-web/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=always
RestartSec=5
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jdownloader-web /mnt/downloads
PrivateTmp=true

[Install]
WantedBy=multi-user.target
