[Unit]
Description=JDownloader 2 Headless
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=jdownloader
Group=jdownloader
WorkingDirectory=/opt/jdownloader
EnvironmentFile=-/etc/jdownloader-web/config.env
ExecStartPre=/usr/bin/timeout 12 /usr/bin/python3 /usr/local/lib/jdownloader/check-nas.py
ExecStart=/usr/bin/java -Djava.awt.headless=true -Djava.net.preferIPv4Stack=true -Xmx2048m -jar /opt/jdownloader/JDownloader.jar -norestart
Restart=always
RestartSec=15
TimeoutStopSec=20
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jdownloader /var/lib/jdownloader /mnt/downloads
PrivateTmp=true

[Install]
WantedBy=multi-user.target
