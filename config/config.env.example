APP_HOST=127.0.0.1
APP_PORT=8000
APP_DATA=/var/lib/jdownloader-web
JD_HOST=127.0.0.1
JD_PORT=3128
DOWNLOAD_PATH=/mnt/downloads
NAS_SOURCE=//192.0.2.30/media
NAS_ROOT=/Downloads
NAS_TARGET="\\\\NAS-SERVER\\media\\Downloads"
NAS_ADMIN_HOST=192.0.2.10
NAS_ADMIN_KEY=/etc/jdownloader-web/nas_key
NAS_ADMIN_KNOWN_HOSTS=/etc/jdownloader-web/nas_known_hosts
NAS_CHECK=/usr/local/lib/jdownloader/check-nas.py
EXTENSION_TOKEN_FILE=/etc/jdownloader-web/browser-extension.token
CNL_PORT=9666
SESSION_TIMEOUT=86400
COOKIE_SECURE=false
