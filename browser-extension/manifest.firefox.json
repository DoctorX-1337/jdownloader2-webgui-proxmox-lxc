{
  "manifest_version": 3,
  "name": "JDownloader 2 · Lokale Übergabe",
  "version": "1.0.2",
  "description": "Leitet Click'n'Load und ausgewählte Links an das lokale JDownloader-Portal weiter.",
  "permissions": ["storage", "contextMenus", "webRequest"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src http://* https://*"},
  "background": {"scripts": ["background.js"]},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "action": {"default_title": "JDownloader 2 öffnen", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}},
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "192": "icons/icon-192.png"},
  "browser_specific_settings": {"gecko": {"id": "jdownloader2-local@custom.local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}
}
